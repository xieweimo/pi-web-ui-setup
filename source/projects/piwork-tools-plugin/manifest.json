{
	"id": "piwork-tools",
	"name": "同步",
	"icon": "⤴",
	"version": "1.0.0",
	"description": "PIwork 工作区工具：顶栏「同步」页（打包并推送 pi-web-ui-setup，与安装包同步）。断连重连是另一个独立插件（reconnect）",
	"permissions": ["ui", "http"],
	"ui": {
		"topbar.primary": [
			{
				"id": "sync",
				"label": "同步",
				"labelEn": "Sync",
				"icon": "⤴",
				"kind": "view",
				"view": "plugin:piwork-tools",
				"order": 23.2,
				"group": "views",
				"align": "end",
				"hint": "打包并推送 pi-web-ui-setup",
				"hintEn": "Package and push pi-web-ui-setup"
			}
		]
	},
	"settings": [
		{
			"key": "repoRoot",
			"type": "text",
			"label": "PIwork 仓库根目录",
			"default": "",
			"hint": "留空 = 用插件目录里 config.json 的 repoRoot（安装器自动写入）"
		}
	]
}
