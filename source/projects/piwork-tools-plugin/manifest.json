{
	"id": "piwork-tools",
	"name": "PIwork",
	"icon": "🛠",
	"version": "1.0.0",
	"description": "PIwork 工作区工具：顶栏「同步」按钮（打包并推送 pi-web-ui-setup），以及断连时的「重连 / 重启网页服务」",
	"permissions": ["ui", "http"],
	"ui": {
		"topbar": [
			{
				"id": "sync",
				"label": "同步",
				"labelEn": "Sync",
				"icon": "⤴",
				"kind": "action",
				"action": "sync",
				"order": 40,
				"hint": "打包并推送 pi-web-ui-setup（脚本：scripts/sync-pi-web-ui-setup.ps1）",
				"hintEn": "Package and push pi-web-ui-setup"
			}
		]
	},
	"settings": [
		{
			"key": "repoRoot",
			"type": "text",
			"label": "PIwork 仓库根目录",
			"default": "",
			"hint": "留空 = 用插件目录里 config.json 的 repoRoot（安装器自动写入）"
		}
	]
}
